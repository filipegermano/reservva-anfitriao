# Banco de dados (SQLite local por padrão, mesmo padrão do reservva-backend)
DATABASE_URL="file:./dev.db"

# Auth.js — gere um valor com `npx auth secret` ou `openssl rand -base64 33`
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# Necessário em produção quando a app roda atrás de proxy/plataforma (Railway, etc.)
AUTH_TRUST_HOST="true"
# Em produção, defina a URL pública real do serviço — o Railway (e proxies
# reversos em geral) não repassa o Host original de forma confiável, então
# sem isso o Auth.js monta redirects de login com o host interno do container.
AUTH_URL="https://seu-app.up.railway.app"

# URL pública usada para montar os links dos guias (QR code, cartaz etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
